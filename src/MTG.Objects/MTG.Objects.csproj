<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <LangVersion>10.0</LangVersion>

    <Copyright>Copyright (c) Mark Gottselig</Copyright>
    <Authors>Mark Gottselig</Authors>
    <Company>Mark Gottselig</Company>
    <Description>Magic: The Gathering objects and data</Description>
    
    <PackageIcon>MTG.Objects.png</PackageIcon>

    <Version>1.0.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>

    <PackageProjectUrl>https://github.com/Greven145/MTG.Objects</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Greven145/MTG.Objects</RepositoryUrl>
    <RepositoryType>Github</RepositoryType>
    <PackageTags>MTG Magic The Gathering</PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\MTG.Objects.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageReference Include="Ardalis.SmartEnum" Version="8.2.0" />
    <PackageReference Include="ValueObject" Version="0.6.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Source Generator Reference -->
  <ItemGroup>
    <ProjectReference Include="..\MTG.Objects.SourceGenerator\MTG.Objects.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Import the targets file that downloads MTGJson data files -->
  <!-- Note: The Tasks project must be built separately before building this project -->
  <Import Project="..\MTG.Objects.SourceGenerator.Tasks\MTG.Objects.SourceGenerator.Tasks.targets" />

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

</Project>